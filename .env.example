# Database (docker compose sets this for the app container)
DATABASE_URL=postgresql://auditor:auditor@localhost:5432/auditor

# Therefore credentials per tenant: THEREFORE_<TENANT>_USERNAME / _PASSWORD
# (tenant ids upper-cased, non-alphanumerics -> _)
THEREFORE_CRAIGDEMO_USERNAME=svc.logaudit
THEREFORE_CRAIGDEMO_PASSWORD=change-me

# LLM (any OpenAI-compatible endpoint: OpenRouter, Azure OpenAI, Ollama, LM Studio)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.5

# Email digest (optional; leave SMTP_HOST empty to only write reports/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Dashboard (auditor web) - single admin login, a placeholder until Entra ID/OIDC replaces it
# (see auditor/web/auth.py). AUDITOR_WEB_SECRET signs the session cookie; generate with
# `openssl rand -hex 32` and keep it stable across restarts, or sessions get invalidated on deploy.
AUDITOR_WEB_USER=admin
AUDITOR_WEB_PASSWORD=change-me
AUDITOR_WEB_SECRET=
