# Database (docker compose sets this for the app container)
DATABASE_URL=postgresql://auditor:auditor@localhost:5432/auditor

# Tenants/servers, their Therefore credentials, per-tenant rule toggles and SMTP delivery are
# configured from the dashboard (Tenants / SMTP), not here - see README.md "Setup". Upgrading
# from an older file-based config? Run `auditor import-legacy-config` once instead of re-entering
# everything.

# LLM (any OpenAI-compatible endpoint: OpenRouter, Azure OpenAI, Ollama, LM Studio)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.5

# Dashboard (auditor web). AUDITOR_WEB_USER/PASSWORD seed the first local login on first boot
# only - after that, manage accounts at /admin/users or `auditor create-user`. AUDITOR_WEB_SECRET
# signs the session cookie; generate with `openssl rand -hex 32` and keep it stable, or sessions
# get invalidated on every deploy.
AUDITOR_WEB_USER=admin
AUDITOR_WEB_PASSWORD=change-me
AUDITOR_WEB_SECRET=

# Encrypts tenant Therefore passwords and the SMTP password stored in the database. Generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Keep it stable - losing it means every stored password becomes unreadable.
AUDITOR_ENC_KEY=
